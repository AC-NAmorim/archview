# Copy to .env and fill in your values

# ── GitHub ────────────────────────────────────────────────────
# Token needs: repo (read), read:org, security_events
GITHUB_TOKEN=ghp_your_token_here
GITHUB_ORGS=my-org,another-org

# ── GitLab (self-hosted) ──────────────────────────────────────
# Token needs: read_api scope
# Generate at: https://gitlab.agilecontent.com/-/profile/personal_access_tokens
GITLAB_TOKEN=glpat_your_token_here
GITLAB_URL=https://gitlab.agilecontent.com
# Comma-separated group IDs or full paths
GITLAB_GROUPS=my-group,my-group/subgroup

# ── Thresholds (days) ────────────────────────────────────────
STALE_COMMIT_DAYS=180
DEAD_COMMIT_DAYS=365

# ── AI classification ─────────────────────────────────────────
# Vertex AI (preferred — uses Application Default Credentials, no key needed)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
ANTHROPIC_VERTEX_REGION=us-east5

# Direct Anthropic API (alternative)
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# Override model (optional — defaults are set per backend)
# ANTHROPIC_MODEL=claude-3-5-haiku@20241022

# ── Output ───────────────────────────────────────────────────
OUTPUT_DIR=./output
MAX_WORKERS=10
