# Bakes the current architecture-overview/index.html into a self-contained image.
# Rebuild this image whenever you regenerate the viewer to publish a new snapshot.
#
#   docker build -f Dockerfile.viewer -t archview-viewer:latest .
#   docker run -p 8080:80 archview-viewer:latest

FROM nginx:alpine

# Remove default nginx page
RUN rm /usr/share/nginx/html/index.html

# Copy current generated viewer (must exist before building)
COPY architecture-overview/index.html /usr/share/nginx/html/index.html

# Minimal nginx config: gzip + no caching (file is regenerated regularly)
RUN printf 'server {\n\
    listen 80;\n\
    root /usr/share/nginx/html;\n\
    gzip on;\n\
    gzip_types text/html application/javascript application/json;\n\
    location / {\n\
        add_header Cache-Control "no-store";\n\
        try_files $uri /index.html;\n\
    }\n\
}\n' > /etc/nginx/conf.d/default.conf

EXPOSE 80
